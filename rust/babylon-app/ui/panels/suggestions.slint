import { SpinBox } from "std-widgets.slint";
import { Colors, DataTable, TableRow } from "../widgets.slint";

export global SuggestionData {
    in property <[TableRow]> rows;
    in property <string> status;
    in-out property <int> minimum: 70;
    callback minimum-changed(int);
    callback activated(int);
}

export component SuggestionPanel inherits VerticalLayout {
    padding: 4px;
    spacing: 4px;
    HorizontalLayout {
        spacing: 6px;
        Text { text: SuggestionData.status; color: Colors.muted; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
        Text { text: @tr("Minimum:"); color: Colors.fore; vertical-alignment: center; }
        SpinBox {
            minimum: 40;
            maximum: 100;
            value <=> SuggestionData.minimum;
            edited(v) => { SuggestionData.minimum-changed(v); }
            width: 90px;
        }
    }
    DataTable {
        headers: [@tr("%"), @tr("Translation"), @tr("Similar text"), @tr("Origin")];
        widths: [44px, 240px, 200px, 100px];
        rows: SuggestionData.rows;
        double-clicked(i) => { SuggestionData.activated(i); }
    }
}
